{
  "name": "@node-c/core",
  "version": "1.0.0-beta9",
  "license": "MIT",
  "main": "./dist/core.js",
  "type": "module",
  "bin": {
    "generateDatasourceFiles": "node ./dist/scripts/generateDatasourceFiles.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist/* && rm -f *.tsbuildinfo && npm run build",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "npx @biomejs/biome format --write",
    "format:check": "npx @biomejs/biome format",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "publish-package": "npm run build:clean && npm publish --access public"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/testing": "12.0.3",
    "@node-c/nestjs-pino": "^1.0.0-beta9",
    "axios": "^1.13.5",
    "dotenv": "^16.6.1",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "nestjs-pino": "^5.2.0",
    "path-to-regexp": "^8.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qs": "^6.15.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^12.0.3",
    "@types/lodash": "^4.17.19",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.1"
  }
}