{
  "name": "@node-c/data-rdb",
  "version": "1.0.0-beta9",
  "license": "MIT",
  "main": "dist/dataRDB.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "rm -rf dist/* && rm -f *.tsbuildinfo && npm run build",
    "build:watch": "npm run build -- -w",
    "build:watch:clean": "rm -rf dist/* && rm -f *.tsbuildinfo && npm run build:watch",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "format": "npx @biomejs/biome format --write",
    "format:check": "npx @biomejs/biome format",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "publish-package": "npm run build:clean && npm publish --access public"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@node-c/core": "^1.0.0-beta9",
    "class-validator": "^0.14.1",
    "lodash": "^4.17.21",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.19"
  }
}