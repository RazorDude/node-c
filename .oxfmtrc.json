{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": ["dist", "node_modules", "packages/nestjs-pino"],
  "jsxSingleQuote": false,
  "printWidth": 80,
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "builtin",
      "unknown",
      "external",
      "internal",
      ["parent", "sibling", "index"]
    ],
    "ignoreCase": false,
    "newlinesBetween": true,
    "order": "asc",
    "partitionByNewline": true
  },
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false
}
